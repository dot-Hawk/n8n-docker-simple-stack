# ==========================================
# CONFIGURACIÓN DE POSTGRESQL
# ==========================================
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=tu_contraseña_segura_aqui
POSTGRES_DB=n8n_db

# ==========================================
# CONFIGURACIÓN DE N8N
# ==========================================
# Zona horaria para la ejecución de flujos
GENERIC_TIMEZONE=America/Argentina/Buenos_Aires

# Clave de encriptación maestra (genera una cadena larga y aleatoria)
N8N_ENCRYPTION_KEY=reemplaza_esta_clave_con_un_hash_aleatorio_muy_seguro

# Permite cargar librerías externas de Node.js en los nodos de código
NODE_FUNCTION_ALLOW_EXTERNAL=lodash,moment

# ==========================================
# CONFIGURACIÓN DEL SANDBOX DE IA (Opcional)
# ==========================================
# Claves de acceso para la API del sandbox seguro
SANDBOX_API_KEYS=tu_api_key_para_el_sandbox
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=token_unico_de_registro_runner
SANDBOX_API_RUNNER_API_KEY=api_key_para_el_runner_dind
